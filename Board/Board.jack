


class Board {
    field int width, height, size, mineCount, flagCount;
    field int startX, startY;
    field int hintX, hintY;
    field Array mines, state;
    field boolean firstMove;


    field Array prevState;
    field int prevCursorX, prevCursorY;
    field int prevHintX, prevHintY;
    field boolean prevShowMines;

    constructor Board new(int w, int h, int minesToPlace) {
        var int i;
        let width = w;
        let height = h;
        let size = w * h;
        let mineCount = minesToPlace;
        let flagCount = 0;
        let firstMove = true;
        let hintX = -1;
        let hintY = -1;
        let startX = (512 - (width * 25)) / 2;
        let startY = 42 + ((180 - (height * 18)) / 2);

        let mines = Array.new(size);
        let state = Array.new(size);
        let prevState = Array.new(size);

        let i = 0;
        while (i < size) {
            let mines[i] = 0;
            let state[i] = 0;
            let prevState[i] = -1;
            let i = i + 1;
        }
        let prevCursorX = -1;
        let prevCursorY = -1;
        let prevHintX = -1;
        let prevHintY = -1;
        let prevShowMines = false;

        do placeMines();
        return this;
    }


    constructor Board newDemo() {
        var int i;
        let width = 16;
        let height = 10;
        let size = 160;
        let mineCount = 25;
        let flagCount = 0;
        let firstMove = false;
        let hintX = -1;
        let hintY = -1;
        let startX = 56;
        let startY = 42;

        let mines = Array.new(size);
        let state = Array.new(size);
        let prevState = Array.new(size);

        let i = 0;
        while (i < size) {
            let mines[i] = 0;
            let state[i] = 0;
            let prevState[i] = -1;
            let i = i + 1;
        }
        let prevCursorX = -1;
        let prevCursorY = -1;
        let prevHintX = -1;
        let prevHintY = -1;
        let prevShowMines = false;

        do placeDemoMines();
        return this;
    }

    method void dispose() {
        do mines.dispose();
        do state.dispose();
        do prevState.dispose();
        do Memory.deAlloc(this);
        return;
    }

    method int getWidth() {
        return width;
    }

    method int getHeight() {
        return height;
    }

    method int getMineCount() {
        return mineCount;
    }

    method int getFlagCount() {
        return flagCount;
    }

    method int getHintX() {
        return hintX;
    }

    method int getHintY() {
        return hintY;
    }

    method boolean isInside(int x, int y) {
        return ((x > -1) & (x < width) & (y > -1) & (y < height));
    }

    method int indexOf(int x, int y) {
        return x + (y * width);
    }

    method int getVisibleState(int x, int y) {
        var int idx;
        if (~isInside(x, y)) {
            return -1;
        }
        let idx = indexOf(x, y);
        return state[idx];
    }

    method boolean isHidden(int x, int y) {
        var int idx;
        if (~isInside(x, y)) {
            return false;
        }
        let idx = indexOf(x, y);
        return ((state[idx] = 0) | (state[idx] = 3));
    }


    method int getVisibleNumber(int x, int y) {
        var int idx;
        if (~isInside(x, y)) {
            return -1;
        }
        let idx = indexOf(x, y);
        if (~(state[idx] = 1)) {
            return -1;
        }
        if (mines[idx] = 1) {
            return -1;
        }
        return getAdjacentMineCount(x, y);
    }


    method boolean reveal(int x, int y) {
        var int idx;
        if (~isInside(x, y)) {
            return false;
        }

        let idx = indexOf(x, y);
        if ((state[idx] = 1) | (state[idx] = 2)) {
            return false;
        }

        if (firstMove) {
            do clearNeighborhoodMines(x, y);
            let firstMove = false;
        }

        if (mines[idx] = 1) {
            let state[idx] = 1;
            return true;
        }

        let state[idx] = 1;
        do expandZeros();
        return false;
    }


    method void flag(int x, int y) {
        var int idx;
        if (~isInside(x, y)) {
            return;
        }
        let idx = indexOf(x, y);

        if (state[idx] = 0) {
            let state[idx] = 2;
            let flagCount = flagCount + 1;
        } else {
            if (state[idx] = 2) {
                let state[idx] = 3;
                let flagCount = flagCount - 1;
            } else {
                if (state[idx] = 3) {
                    let state[idx] = 0;
                }
            }
        }
        return;
    }

    method boolean gameWon() {
        var int i;
        let i = 0;
        while (i < size) {
            if ((mines[i] = 0) & ~(state[i] = 1)) {
                return false;
            }
            let i = i + 1;
        }
        return true;
    }

    method int countUnknownCells() {
        var int i, count;
        let i = 0;
        let count = 0;
        while (i < size) {
            if ((state[i] = 0) | (state[i] = 3)) {
                let count = count + 1;
            }
            let i = i + 1;
        }
        return count;
    }



    method boolean hasHiddenSafeNeighbor(int x, int y) {
        var int dx, dy, nx, ny, idx;
        let dy = -1;
        while (dy < 2) {
            let dx = -1;
            while (dx < 2) {
                if (~((dx = 0) & (dy = 0))) {
                    let nx = x + dx;
                    let ny = y + dy;
                    if (isInside(nx, ny)) {
                        let idx = indexOf(nx, ny);
                        if (((state[idx] = 0) | (state[idx] = 3)) & (mines[idx] = 0)) {
                            return true;
                        }
                    }
                }
                let dx = dx + 1;
            }
            let dy = dy + 1;
        }
        return false;
    }

    method int countHiddenSafeNeighbors(int x, int y) {
        var int dx, dy, nx, ny, idx, count;
        let count = 0;
        let dy = -1;
        while (dy < 2) {
            let dx = -1;
            while (dx < 2) {
                if (~((dx = 0) & (dy = 0))) {
                    let nx = x + dx;
                    let ny = y + dy;
                    if (isInside(nx, ny)) {
                        let idx = indexOf(nx, ny);
                        if (((state[idx] = 0) | (state[idx] = 3)) & (mines[idx] = 0)) {
                            let count = count + 1;
                        }
                    }
                }
                let dx = dx + 1;
            }
            let dy = dy + 1;
        }
        return count;
    }

    method int getNthHiddenSafeNeighbor(int x, int y, int targetN) {
        var int dx, dy, nx, ny, idx, current;
        let current = 0;
        let dy = -1;
        while (dy < 2) {
            let dx = -1;
            while (dx < 2) {
                if (~((dx = 0) & (dy = 0))) {
                    let nx = x + dx;
                    let ny = y + dy;
                    if (isInside(nx, ny)) {
                        let idx = indexOf(nx, ny);
                        if (((state[idx] = 0) | (state[idx] = 3)) & (mines[idx] = 0)) {
                            if (current = targetN) {
                                return idx;
                            }
                            let current = current + 1;
                        }
                    }
                }
                let dx = dx + 1;
            }
            let dy = dy + 1;
        }
        return -1;
    }

  
    method boolean giveHint() {
        var int x, y, idx, clueCount, targetClue, currentClue;
        var int safeCount, targetSafe, safeIdx, totalSafe, targetAny, currentAny;
        var boolean hitMine;

        let clueCount = 0;
        let y = 0;
        while (y < height) {
            let x = 0;
            while (x < width) {
                let idx = indexOf(x, y);
                if ((state[idx] = 1) & (mines[idx] = 0) & (getAdjacentMineCount(x, y) > 0)) {
                    if (hasHiddenSafeNeighbor(x, y)) {
                        let clueCount = clueCount + 1;
                    }
                }
                let x = x + 1;
            }
            let y = y + 1;
        }

        if (clueCount > 0) {
            let targetClue = Random.randInt(0, clueCount);
            let currentClue = 0;
            let y = 0;
            while (y < height) {
                let x = 0;
                while (x < width) {
                    let idx = indexOf(x, y);
                    if ((state[idx] = 1) & (mines[idx] = 0) & (getAdjacentMineCount(x, y) > 0)) {
                        if (hasHiddenSafeNeighbor(x, y)) {
                            if (currentClue = targetClue) {
                                let safeCount = countHiddenSafeNeighbors(x, y);
                                let targetSafe = Random.randInt(0, safeCount);
                                let safeIdx = getNthHiddenSafeNeighbor(x, y, targetSafe);
                                if (safeIdx > -1) {
                                    let hintX = Maths.mod(safeIdx, width);
                                    let hintY = safeIdx / width;
                                    let hitMine = reveal(hintX, hintY);
                                    return true;
                                }
                            }
                            let currentClue = currentClue + 1;
                        }
                    }
                    let x = x + 1;
                }
                let y = y + 1;
            }
        }

        let totalSafe = 0;
        let idx = 0;
        while (idx < size) {
            if (((state[idx] = 0) | (state[idx] = 3)) & (mines[idx] = 0)) {
                let totalSafe = totalSafe + 1;
            }
            let idx = idx + 1;
        }

        if (totalSafe > 0) {
            let targetAny = Random.randInt(0, totalSafe);
            let currentAny = 0;
            let idx = 0;
            while (idx < size) {
                if (((state[idx] = 0) | (state[idx] = 3)) & (mines[idx] = 0)) {
                    if (currentAny = targetAny) {
                        let hintX = Maths.mod(idx, width);
                        let hintY = idx / width;
                        let hitMine = reveal(hintX, hintY);
                        return true;
                    }
                    let currentAny = currentAny + 1;
                }
                let idx = idx + 1;
            }
        }

        return false;
    }


    method void draw(int cursorX, int cursorY, boolean showMines) {
        var int x, y, idx, cellState, number, px, py;
        var boolean cellChanged;

        let y = 0;
        while (y < height) {
            let x = 0;
            while (x < width) {
                let idx = indexOf(x, y);
                let cellState = state[idx];

                let cellChanged = false;
                if (~(prevState[idx] = cellState)) { let cellChanged = true; }
                if (~(showMines = prevShowMines)) { let cellChanged = true; }
                if ((x = cursorX) & (y = cursorY)) { let cellChanged = true; }
                if ((x = prevCursorX) & (y = prevCursorY)) { let cellChanged = true; }
                if ((x = hintX) & (y = hintY)) { let cellChanged = true; }
                if ((x = prevHintX) & (y = prevHintY)) { let cellChanged = true; }

                if (cellChanged) {
                    let px = startX + (x * 25);
                    let py = startY + (y * 18);

                    if (showMines & (mines[idx] = 1)) {
                        do drawRevealedTile(px, py);
                        do drawMineIcon(px, py);
                    } else {
                        if (cellState = 2) {
                            do drawHiddenTile(px, py);
                            do drawFlagIcon(px, py);
                        } else {
                            if (cellState = 3) {
                                do drawHiddenTile(px, py);
                                do drawQuestionIcon(px, py);
                            } else {
                                if (cellState = 1) {
                                    let number = getAdjacentMineCount(x, y);
                                    if ((x = hintX) & (y = hintY)) {
                                        do drawHintTile(px, py, number);
                                    } else {
                                        do drawRevealedTile(px, py);
                                        if (number > 0) {
                                            do drawNumber(number, px, py, true);
                                        }
                                    }
                                } else {
                                    do drawHiddenTile(px, py);
                                }
                            }
                        }
                    }

                    if ((x = cursorX) & (y = cursorY)) {
                        do drawCursor(px, py);
                    }

                    let prevState[idx] = cellState;
                }

                let x = x + 1;
            }
            let y = y + 1;
        }

        let prevCursorX = cursorX;
        let prevCursorY = cursorY;
        let prevHintX = hintX;
        let prevHintY = hintY;
        let prevShowMines = showMines;
        return;
    }

    method void drawHiddenTile(int px, int py) {


        do Screen.setColor(false);
        do Screen.drawRectangle(px, py, px + 24, py + 17);

        do Screen.setColor(true);
        do Screen.drawRectangle(px, py, px + 24, py + 1);
        do Screen.drawRectangle(px, py, px + 1, py + 17);
        do Screen.drawRectangle(px, py + 15, px + 24, py + 17);
        do Screen.drawRectangle(px + 22, py, px + 24, py + 17);

        do Screen.drawLine(px + 4, py + 3, px + 19, py + 3);
        do Screen.drawLine(px + 3, py + 4, px + 3, py + 12);
        return;
    }

    method void drawRevealedTile(int px, int py) {

        do Screen.setColor(false);
        do Screen.drawRectangle(px, py, px + 24, py + 17);
        do Screen.setColor(true);
        do Screen.drawLine(px, py, px + 24, py);
        do Screen.drawLine(px, py, px, py + 17);
        do Screen.drawLine(px, py + 17, px + 24, py + 17);
        do Screen.drawLine(px + 24, py, px + 24, py + 17);
        return;
    }

        do Screen.setColor(true);
        do Screen.drawRectangle(px, py, px + 24, py + 17);


        do Screen.setColor(false);
        do Screen.drawRectangle(px + 1, py + 1, px + 23, py + 16);
        do Screen.setColor(true);
        do Screen.drawRectangle(px + 2, py + 2, px + 22, py + 15);

        
        if (number > 0) {
            do drawNumber(number, px, py, false);
        }
        return;
    }

    method void drawFlagIcon(int px, int py) {
        do Screen.setColor(true);
        
        do Screen.drawRectangle(px + 7, py + 4, px + 15, py + 5);
        do Screen.drawRectangle(px + 9, py + 6, px + 15, py + 7);
        do Screen.drawRectangle(px + 11, py + 8, px + 15, py + 9);

        do Screen.drawRectangle(px + 15, py + 4, px + 16, py + 13);
        do Screen.drawRectangle(px + 10, py + 13, px + 20, py + 14);
        return;
    }


    method void drawQuestionIcon(int px, int py) {
        do Screen.setColor(true);

        do Screen.drawRectangle(px + 10, py + 3, px + 14, py + 4);

        do Screen.drawRectangle(px + 9, py + 4, px + 10, py + 6);
        do Screen.drawRectangle(px + 14, py + 4, px + 15, py + 6);

        do Screen.drawRectangle(px + 12, py + 6, px + 15, py + 7);

        do Screen.drawRectangle(px + 12, py + 7, px + 13, py + 10);

        do Screen.drawRectangle(px + 12, py + 12, px + 13, py + 14);
        return;
    }

    method void drawMineIcon(int px, int py) {
        do Screen.setColor(true);
        do Screen.drawCircle(px + 12, py + 9, 4);
        do Screen.drawLine(px + 12, py + 2, px + 12, py + 16);
        do Screen.drawLine(px + 5, py + 9, px + 19, py + 9);
        do Screen.drawLine(px + 7, py + 4, px + 17, py + 14);
        do Screen.drawLine(px + 7, py + 14, px + 17, py + 4);
        return;
    }

    method void drawNumber(int number, int px, int py, boolean color) {
        do Screen.setColor(color);


        if ((number = 2) | (number = 3) | (number = 5) |
            (number = 6) | (number = 7) | (number = 8)) {
            do drawNumberH(px, py, 4);
        }

        if ((number = 2) | (number = 3) | (number = 4) |
            (number = 5) | (number = 6) | (number = 8)) {
            do drawNumberH(px, py, 8);
        }


        if ((number = 2) | (number = 3) | (number = 5) |
            (number = 6) | (number = 8)) {
            do drawNumberH(px, py, 12);
        }


        if ((number = 4) | (number = 5) | (number = 6) | (number = 8)) {
            do drawNumberV(px, py, 9, 4);
        }


        if ((number = 1) | (number = 2) | (number = 3) |
            (number = 4) | (number = 7) | (number = 8)) {
            do drawNumberV(px, py, 15, 4);
        }


        if ((number = 2) | (number = 6) | (number = 8)) {
            do drawNumberV(px, py, 9, 8);
        }


        if ((number = 1) | (number = 3) | (number = 4) |
            (number = 5) | (number = 6) | (number = 7) |
            (number = 8)) {
            do drawNumberV(px, py, 15, 8);
        }
        return;
    }

    method void drawNumberH(int px, int py, int yOffset) {
        do Screen.drawRectangle(px + 10, py + yOffset, px + 15, py + yOffset + 1);
        return;
    }

    method void drawNumberV(int px, int py, int xOffset, int yOffset) {
        do Screen.drawRectangle(px + xOffset, py + yOffset, px + xOffset + 1, py + yOffset + 4);
        return;
    }

    method void drawCursor(int px, int py) {
        do Screen.setColor(true);

        do Screen.drawRectangle(px + 3, py + 3, px + 8, py + 4);
        do Screen.drawRectangle(px + 3, py + 3, px + 4, py + 8);

        do Screen.drawRectangle(px + 16, py + 3, px + 21, py + 4);
        do Screen.drawRectangle(px + 20, py + 3, px + 21, py + 8);

        do Screen.drawRectangle(px + 3, py + 13, px + 8, py + 14);
        do Screen.drawRectangle(px + 3, py + 9, px + 4, py + 14);

        do Screen.drawRectangle(px + 16, py + 13, px + 21, py + 14);
        do Screen.drawRectangle(px + 20, py + 9, px + 21, py + 14);
        return;
    }


    method boolean isMineForDisplay(int x, int y) {
        var int idx;
        if (~isInside(x, y)) {
            return false;
        }
        let idx = indexOf(x, y);
        return (mines[idx] = 1);
    }



    method void placeDemoMines() {
        let mines[1] = 1;
        let mines[10] = 1;
        let mines[13] = 1;
        let mines[20] = 1;
        let mines[28] = 1;
        let mines[33] = 1;
        let mines[35] = 1;
        let mines[40] = 1;
        let mines[43] = 1;
        let mines[47] = 1;
        let mines[60] = 1;
        let mines[68] = 1;
        let mines[85] = 1;
        let mines[86] = 1;
        let mines[95] = 1;
        let mines[97] = 1;
        let mines[108] = 1;
        let mines[115] = 1;
        let mines[118] = 1;
        let mines[128] = 1;
        let mines[129] = 1;
        let mines[141] = 1;
        let mines[144] = 1;
        let mines[156] = 1;
        let mines[159] = 1;
        return;
    }

    method void placeMines() {
        var int placed, idx;
        let placed = 0;
        while (placed < mineCount) {
            let idx = Random.randInt(0, size);
            if (mines[idx] = 0) {
                let mines[idx] = 1;
                let placed = placed + 1;
            }
        }
        return;
    }


    method boolean isInNeighborhood(int idx, int cx, int cy) {
        var int ix, iy;
        let ix = Maths.mod(idx, width);
        let iy = idx / width;
        if ((ix > (cx - 2)) & (ix < (cx + 2)) & (iy > (cy - 2)) & (iy < (cy + 2))) {
            return true;
        }
        return false;
    }


    method void clearNeighborhoodMines(int cx, int cy) {
        var int dx, dy, nx, ny, nidx, targetIdx;
        var boolean found;

        let dy = -1;
        while (dy < 2) {
            let dx = -1;
            while (dx < 2) {
                let nx = cx + dx;
                let ny = cy + dy;
                if (isInside(nx, ny)) {
                    let nidx = indexOf(nx, ny);
                    if (mines[nidx] = 1) {
                        let mines[nidx] = 0;

                        
                        let targetIdx = Random.randInt(0, size);
                        let found = false;
                        while (~found) {
                            if (targetIdx = size) {
                                let targetIdx = 0;
                            }
                            if ((mines[targetIdx] = 0) & (~isInNeighborhood(targetIdx, cx, cy))) {
                                let mines[targetIdx] = 1;
                                let found = true;
                            }
                            let targetIdx = targetIdx + 1;
                        }

                    }
                }
                let dx = dx + 1;
            }
            let dy = dy + 1;
        }
        
        return;
    }

    method int getAdjacentMineCount(int x, int y) {
        var int dx, dy, nx, ny, idx, count;
        let count = 0;
        let dy = -1;
        while (dy < 2) {
            let dx = -1;
            while (dx < 2) {
                if (~((dx = 0) & (dy = 0))) {
                    let nx = x + dx;
                    let ny = y + dy;
                    if (isInside(nx, ny)) {
                        let idx = indexOf(nx, ny);
                        if (mines[idx] = 1) {
                            let count = count + 1;
                        }
                    }
                }
                let dx = dx + 1;
            }
            let dy = dy + 1;
        }
        return count;
    }

    method void expandZeros() {
        var boolean changed;
        var int x, y, idx, dx, dy, nx, ny, nidx;

        let changed = true;
        while (changed) {
            let changed = false;
            let y = 0;
            while (y < height) {
                let x = 0;
                while (x < width) {
                    let idx = indexOf(x, y);
                    if ((state[idx] = 1) & (mines[idx] = 0)) {
                        if (getAdjacentMineCount(x, y) = 0) {
                            let dy = -1;
                            while (dy < 2) {
                                let dx = -1;
                                while (dx < 2) {
                                    if (~((dx = 0) & (dy = 0))) {
                                        let nx = x + dx;
                                        let ny = y + dy;
                                        if (isInside(nx, ny)) {
                                            let nidx = indexOf(nx, ny);
                                            if (((state[nidx] = 0) | (state[nidx] = 3)) & (mines[nidx] = 0)) {
                                                let state[nidx] = 1;
                                                let changed = true;
                                            }
                                        }
                                    }
                                    let dx = dx + 1;
                                }
                                let dy = dy + 1;
                            }
                        }
                    }
                    let x = x + 1;
                }
                let y = y + 1;
            }
        }
        return;
    }
}
